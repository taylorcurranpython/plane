{
  "name": "@plane/vitest-config",
  "version": "1.4.2",
  "private": true,
  "description": "Shared Vitest presets for Plane frontend apps and packages",
  "license": "AGPL-3.0",
  "files": [
    "node.js",
    "node.d.ts",
    "react.js",
    "react.d.ts",
    "setup.js",
    "setup.d.ts"
  ],
  "type": "module",
  "exports": {
    "./node": {
      "types": "./node.d.ts",
      "default": "./node.js"
    },
    "./react": {
      "types": "./react.d.ts",
      "default": "./react.js"
    },
    "./setup": {
      "types": "./setup.d.ts",
      "default": "./setup.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "check:lint": "oxlint .",
    "check:format": "oxfmt --check .",
    "fix:lint": "oxlint --fix .",
    "fix:format": "oxfmt .",
    "clean": "rm -rf .turbo && rm -rf node_modules"
  },
  "dependencies": {
    "@testing-library/jest-dom": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:"
  }
}
