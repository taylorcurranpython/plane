# URL the Playwright browser opens (the web app).
PLAYWRIGHT_BASE_URL="http://localhost:3000"
# Django API used by the helpers for health checks and instance config.
E2E_API_BASE_URL="http://localhost:8000"
# Credentials of the seeded user (must match the values used when seeding, see README).
E2E_USER_EMAIL="e2e@plane.local"
E2E_USER_PASSWORD="e2e-password-1234!"
E2E_WORKSPACE_SLUG="e2e"
# Uncomment to also run Firefox and WebKit projects.
# E2E_ALL_BROWSERS=1
# Uncomment when the web app is already running (skips Playwright's webServer).
# PLAYWRIGHT_SKIP_WEB_SERVER=1
# Serve an existing `apps/web/build` instead of rebuilding first.
# PLAYWRIGHT_WEB_SERVER_COMMAND="pnpm --filter=web start"
